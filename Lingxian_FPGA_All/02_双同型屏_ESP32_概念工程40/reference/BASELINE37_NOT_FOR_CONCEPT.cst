// The same board clock/DAC/buttons used by the successful audio bring-up.
IO_LOC "sys_clk" V22;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;
IO_LOC "rst_button_n" Y12;
IO_PORT "rst_button_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "play_button_n" AB13;
IO_PORT "play_button_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "mode_button_n" AA13;
IO_PORT "mode_button_n" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC "HP_BCK" Y17;
IO_LOC "HP_WS" AB17;
IO_LOC "HP_DIN" AA16;
IO_LOC "PA_EN" AB16;
IO_PORT "HP_BCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=8;
IO_PORT "HP_WS" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=8;
IO_PORT "HP_DIN" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=8;
IO_PORT "PA_EN" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=8;

IO_LOC "LCD_CS" E14;
IO_PORT "LCD_CS" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;

IO_LOC "LCD_RST" E13;
IO_PORT "LCD_RST" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;

IO_LOC "LCD_RS" C15;
IO_PORT "LCD_RS" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;

IO_LOC "LCD_MOSI" C14;
IO_PORT "LCD_MOSI" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;

IO_LOC "LCD_SCK" B13;
IO_PORT "LCD_SCK" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;

IO_LOC "CTP_RST" C13;
IO_PORT "CTP_RST" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;

IO_LOC "CTP_SCL" A14;
IO_PORT "CTP_SCL" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3 DRIVE=4;

IO_LOC "CTP_SDA" A13;
IO_PORT "CTP_SDA" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3 DRIVE=4;

IO_LOC "SD_CS" B15;
IO_PORT "SD_CS" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;

IO_LOC "HOST_RX" A16;
IO_PORT "HOST_RX" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC "HOST_TX" A15;
IO_PORT "HOST_TX" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "LED_N[0]" T18;
IO_PORT "LED_N[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "LED_N[1]" R18;
IO_PORT "LED_N[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "LED_N[2]" R17;
IO_PORT "LED_N[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "LED_N[3]" P16;
IO_PORT "LED_N[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "LED_N[4]" U21;
IO_PORT "LED_N[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "LED_N[5]" T21;
IO_PORT "LED_N[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "LED_N[6]" R19;
IO_PORT "LED_N[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;
IO_LOC "LED_N[7]" P19;
IO_PORT "LED_N[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3 DRIVE=4;

// J13-15 = SDRAM0_D11 = A20; unused 3.3V GPIO.
IO_LOC "MIC_DO" A20;
IO_PORT "MIC_DO" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// Encoder kept separate from MIC_DO A20/J13-15.
IO_LOC "ENCODER_CLK" B20;
IO_PORT "ENCODER_CLK" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ENCODER_DT" A21;
IO_PORT "ENCODER_DT" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "ENCODER_SW_N" B21;
IO_PORT "ENCODER_SW_N" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
